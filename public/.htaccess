# Route everything through the front controller (Apache / LiteSpeed shared hosting)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # If installed in a subfolder, set RewriteBase accordingly, e.g. RewriteBase /menu
    # RewriteBase /

    # Serve existing files / directories directly (assets, uploads)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else -> index.php
    RewriteRule ^ index.php [L]
</IfModule>

# Security: do not list directories
Options -Indexes

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
</IfModule>

# Gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>
